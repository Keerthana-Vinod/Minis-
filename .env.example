# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# API Configuration
API_TITLE="Food Product Assistant API"
API_VERSION="1.0.0"

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"  # Get from https://makersuite.google.com/app/apikey
MODEL_NAME="gemini-1.5-flash"  # or "gemini-1.5-pro" for better quality
MAX_TOKENS=2048
TEMPERATURE=0.7

# GPU Configuration
USE_GPU=true  # Set to false to disable GPU acceleration

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="*"

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES="image/jpeg,image/png"

# Logging
LOG_LEVEL="INFO"
